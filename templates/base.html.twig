<!DOCTYPE html>
<html lang="">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{% block title %}TableTop{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('pwa/favicon-96x96.png') }}" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('pwa/favicon.svg') }}" />
        <link rel="shortcut icon" href="{{ asset('pwa/favicon.ico') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('pwa/apple-touch-icon.png') }}" />
        <meta name="apple-mobile-web-app-title" content="TableTop" />
        <link rel="manifest" href="{{ asset('manifest.json') }}" />
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
</head>
    <body>
    <script id="sidebarInit">
        if (localStorage.getItem('sidebar') === 'true') {
            document.body.classList.add('sb-sidenav-toggled');
        }
        document.getElementById("sidebarInit").remove();
    </script>
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            {% include 'includes/_dice.html.twig' %}
            {% include 'includes/_notify.html.twig' %}
            {% include 'includes/_nav.html.twig' %}
        {% endif %}
        {% include 'includes/_pwa.html.twig' %}
        {% block body %}{% endblock %}
    </body>
</html>
